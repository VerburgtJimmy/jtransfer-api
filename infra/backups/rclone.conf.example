# Copy to /etc/jtransfer/rclone.conf and fill in. chmod 600.
#
# Scaleway Object Storage in Amsterdam region.
# Generate the access_key_id / secret_access_key under
# Scaleway console -> IAM -> API keys. Scope the application to the
# backup bucket only when possible.

[scaleway-backups]
type = s3
provider = Scaleway
region = nl-ams
endpoint = s3.nl-ams.scw.cloud
access_key_id = SCW_CHANGE_ME
secret_access_key = CHANGE_ME
acl = private
