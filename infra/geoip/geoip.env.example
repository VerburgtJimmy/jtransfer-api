# GeoIP refresh credentials — read only by /opt/tessil/setup-geoip.sh.
# The running API does not read these.
#
# Register a free account at https://www.maxmind.com/en/geolite2/signup
# and generate a license key scoped to "GeoIP Update".

MAXMIND_ACCOUNT_ID=your_maxmind_account_id
MAXMIND_LICENSE_KEY=your_maxmind_license_key

# Where the MMDB files land. Must match the running API's GEOIP_DIR.
GEOIP_DIR=/var/lib/geoip
