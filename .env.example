# Database
DATABASE_URL=postgresql://user:password@localhost:5432/jtransfer

# Test database — required when running `bun test`. MUST be a disposable
# database; the test harness truncates all tables between tests.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/jtransfer_test

# CORS
CORS_ORIGINS=http://localhost:5173

# Server
PORT=3000

# Cloudflare R2 Storage
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=jtransfer

# Optional: Max file size in bytes (default: 1GB)
# MAX_FILE_SIZE=1073741824

# Optional: Redis for rate limiting (falls back to in-memory if not set)
# REDIS_URL=redis://localhost:6379

# Rate Limits (all optional, shown with defaults)
# RATE_LIMIT_UPLOADS_PER_MINUTE=5      # Upload requests per minute per IP
# RATE_LIMIT_DOWNLOADS_PER_MINUTE=20   # Download requests per minute per IP
# RATE_LIMIT_DAILY_TRANSFERS=20        # New transfers per day per IP
# RATE_LIMIT_DAILY_DOWNLOADS=200       # File downloads per day per IP
# RATE_LIMIT_MONTHLY_UPLOAD_GB=2       # Total upload volume per month per IP (in GB)

# IP minimization / GeoIP (audit doc 19, ADR-0002)
# MaxMind credentials are only used by infra/setup-geoip.sh to download
# the GeoLite2 Country / ASN / City MMDB files. Register a free account
# at https://www.maxmind.com/en/geolite2/signup to get them.
# MAXMIND_ACCOUNT_ID=your_maxmind_account_id
# MAXMIND_LICENSE_KEY=your_maxmind_license_key
# GEOIP_DIR=/var/lib/geoip                  # where the MMDB files live on disk
# ENABLE_IP_DERIVATION=true                 # set to false to disable geo/ASN derivation entirely (debugging only)
# ENABLE_SESSION_ANOMALY_EMAIL=true         # set to false to suppress session-anomaly emails (ADR-0003)
