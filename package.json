{
  "name": "jtransfer-api",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "auth:smoke": "bun run scripts/auth-smoke.ts",
    "check:no-raw-ip": "bun run scripts/check-no-raw-ip.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@elysiajs/cors": "^1.1.0",
    "@elysiajs/cron": "^1.4.1",
    "@polar-sh/sdk": "^0.47.1",
    "@simplewebauthn/server": "^13.3.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.22",
    "ioredis": "^5.9.2",
    "maxmind": "^5.0.6",
    "nanoid": "^5.0.9",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "bun-types": "^1.3.6",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.6"
  },
  "module": "src/index.js"
}
