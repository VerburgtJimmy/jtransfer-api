# Copy to /etc/jtransfer/backup.env and fill in. chmod 600.

# Postgres connection. Quote if it contains special characters.
DATABASE_URL="postgres://jtransfer:CHANGE_ME@127.0.0.1:5432/jtransfer"

# Path to the committed age recipients file, deployed alongside the script.
AGE_RECIPIENTS_FILE=/etc/jtransfer/age-recipients.txt

# rclone configuration. Storage Box credentials live here, so chmod 600.
RCLONE_CONFIG=/etc/jtransfer/rclone.conf

# rclone remote name + path. The bucket/folder is created on first upload.
RCLONE_REMOTE=hetzner-storagebox:jtransfer-backups

# Optional: how many days of backups to retain on the remote. Defaults to 30.
# RETENTION_DAYS=30
