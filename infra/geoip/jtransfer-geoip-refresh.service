[Unit]
Description=JTransfer GeoLite2 MMDB refresh (Country + ASN + City)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/jtransfer/geoip.env
ExecStart=/opt/jtransfer/setup-geoip.sh
SyslogIdentifier=jtransfer-geoip-refresh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# Hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/geoip
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
